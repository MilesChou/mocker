{
    "name": "mileschou/mocker",
    "description": "The mock helper for HTTP client.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "http-client"
    ],
    "authors": [
        {
            "name": "MilesChou",
            "email": "jangconan@gmail.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.1",
        "mileschou/psr": "^1.0 | ^2.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Require ^6 if need use Guzzle MockerBuilder"
    },
    "require-dev": {
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7",
        "phpunit/phpunit": "^10",
        "slevomat/coding-standard": "^8.19",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "MilesChou\\Mocker\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
